[sub_resource type="Shader" id="Shader_rest_vignette"]
code = "shader_type canvas_item;

uniform float strength : hint_range(0.0, 1.0) = 0.0;

void fragment() {
	vec2 centered = UV * 2.0 - 1.0;
	centered.x *= 0.5625;
	float distance_from_center = length(centered);
	float edge = smoothstep(0.38, 0.9, distance_from_center);
	float alpha = edge * 0.48 * strength;
	COLOR = vec4(0.035, 0.025, 0.07, alpha);
}
"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_rest_vignette"]
shader = SubResource("Shader_rest_vignette")
shader_parameter/strength = 0.0

