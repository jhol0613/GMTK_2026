metadata/_custom_type_script = "uid://bnh3vfxgbhvxy"

[sub_resource type="Resource" id="Resource_ty8k3"]
script = ExtResource("2_hl41d")
text = "Stuck up here forever, hopping from train to train!"
speaker_icon = ExtResource("4_nmkwl")
metadata/_custom_type_script = "uid://bnh3vfxgbhvxy"

[sub_resource type="Resource" id="Resource_6mhbs"]
