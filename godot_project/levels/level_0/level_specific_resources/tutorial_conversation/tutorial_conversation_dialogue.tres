[sub_resource type="Resource" id="Resource_w11hi"]
script = ExtResource("2_hl41d")
text = "I'm so glad you're here, I can't read a word of this!"
speaker_icon = ExtResource("3_sb42r")
metadata/_custom_type_script = "uid://bnh3vfxgbhvxy"

[sub_resource type="Resource" id="Resource_s81r5"]
script = ExtResource("2_hl41d")
text = "Yeah, if I wasn't, you'd never get down from here..."
speaker_icon = ExtResource("4_nmkwl")
metadata/_custom_type_script = "uid://bnh3vfxgbhvxy"

[sub_resource type="Resource" id="Resource_d1dci"]
