[sub_resource type="Resource" id="Resource_w11hi"]
script = ExtResource("2_6pmic")
text = "I'm so glad to be back! Let's stick together this time, ok?"
speaker_icon = ExtResource("3_8w2im")
metadata/_custom_type_script = "uid://bnh3vfxgbhvxy"

[sub_resource type="Resource" id="Resource_s81r5"]
script = ExtResource("2_6pmic")
text = "I'm not the one who missed the train."
speaker_icon = ExtResource("4_0gvgc")
metadata/_custom_type_script = "uid://bnh3vfxgbhvxy"

[sub_resource type="Resource" id="Resource_d1dci"]
script = ExtResource("2_6pmic")
text = "You should watch your step this time."
speaker_icon = ExtResource("5_d4xve")
metadata/_custom_type_script = "uid://bnh3vfxgbhvxy"

[sub_resource type="Resource" id="Resource_vrhds"]
script = ExtResource("2_6pmic")
text = "I don't want to find you sleeping on a bench at %s again."
speaker_icon = ExtResource("4_0gvgc")
metadata/_custom_type_script = "uid://bnh3vfxgbhvxy"

[sub_resource type="Resource" id="Resource_6mhbs"]
script = ExtResource("2_6pmic")
text = "Hey at least I made it to %s."
speaker_icon = ExtResource("6_dkmfd")
metadata/_custom_type_script = "uid://bnh3vfxgbhvxy"

[sub_resource type="Resource" id="Resource_hiktp"]
script = ExtResource("2_6pmic")
text = "I'm impressed you even know what %s is."
speaker_icon = ExtResource("7_x3ouk")
metadata/_custom_type_script = "uid://bnh3vfxgbhvxy"

[sub_resource type="Resource" id="Resource_yy6oh"]
script = ExtResource("2_6pmic")
text = "I learned a lot last time!"
speaker_icon = ExtResource("3_8w2im")
metadata/_custom_type_script = "uid://bnh3vfxgbhvxy"

[sub_resource type="Resource" id="Resource_63f8k"]
script = ExtResource("2_6pmic")
text = "I even brought my notebook again. Maybe I can keep adding to it!"
speaker_icon = ExtResource("8_2ut87")
metadata/_custom_type_script = "uid://bnh3vfxgbhvxy"

[sub_resource type="Resource" id="Resource_ppbrf"]
