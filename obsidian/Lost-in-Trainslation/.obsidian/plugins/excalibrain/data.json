    "#location": {
      "prefix": "📍",
      "backgroundColor": "#f02d7b66"
    },
    "#puzzle": {
      "prefix": "🧩",
      "backgroundColor": "#0df84766"
    },
    "#source": {
      "prefix": "🔎",
      "backgroundColor": "#65bafb66"
    },
    "#word": {
      "prefix": "🔤",
      "backgroundColor": "#cf88dd66"
    }
  },
  "tagStyleList": [
    "#knowledge",
    "#location",
    "#puzzle",
    "#source",
    "#word"
